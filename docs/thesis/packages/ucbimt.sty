%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Chapter Format
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\newcommand*{\standardChapterStyle}{%
    \titleformat{\chapter}[display]
    {\normalfont\LARGE\bfseries}
    {\chaptertitlename\ \thechapter}
    {20pt}
    {\Huge}

    \titlespacing*{\chapter}
    {0pt}
    {50pt}
    {40pt}
}

\newcommand*{\myChapterStyle}{%
    \titleformat{\chapter}[display]
    {\normalfont\LARGE\bfseries \vspace{-1cm}}
    {
        \vline height 45pt depth 55pt width 15pt
        \hspace{1.8cm}
        \MakeUppercase{\chaptertitlename}\ \thechapter
    }
    {-5pt}
    {
        \vline depth 45pt width 15pt
        \hspace{1.8cm}
        \MakeUppercase
    }

    \titlespacing*{\chapter}
    {0pt}
    {50pt}
    {40pt}
}

\newcommand*{\myChapterStyleB}{%
    \titleformat{\chapter}[display]
    {\normalfont\fontsize{12}{15}\bfseries}
    {\chaptertitlename\ \thechapter}
    {20pt}
    {}

    \titlespacing*{\chapter}
    {0pt}
    {50pt}
    {40pt}
}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Section Format
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\setcounter{tocdepth}{3}
\setcounter{secnumdepth}{3}

\newcommand{\standardSectionStyle}{%
    \titleformat{\section}
    {\normalfont\bfseries}
    {\thesection}
    {1em}
    {}
}

\newcommand{\mySectionStyle}{%
    \titleformat{\section}
    {\normalfont\fontsize{12}{15}\bfseries}
    {\thesection}
    {1em}
    {}
}

\newcommand*{\mySectionStyleB}{%
    \titleformat{\section}
    {\normalfont\fontsize{12}{15}\bfseries\centering}
    {\MakeUppercase{\thesection}}
    {1em}
    {\MakeUppercase}
}

